-- ==========================================
-- 2. RAYCAST & TARGET LOGIC
-- ==========================================
local function checkPierceVisibility(currentOrigin, currentDirection, targetPos, dynamicFilter, targetCharacter, pierceCount)
    local maxPierces = pierceCount or 1 

    for i = 1, maxPierces do
        sharedRaycast.FilterDescendantsInstances = dynamicFilter
        local result = Workspace:Raycast(currentOrigin, currentDirection, sharedRaycast)
        
        if not result then return true end

        local hitPart = result.Instance
        if hitPart:IsDescendantOf(targetCharacter) then return true end

        if maxPierces > 1 and (hitPart.Transparency > 0.8 or not hitPart.CanCollide) then
            table.insert(dynamicFilter, hitPart)
            
            local offset = targetPos - result.Position
            local distance = offset.Magnitude

            -- ป้องกัน Vector Zero Division Error
            if distance <= 1e-4 then
                return false
            end

            currentDirection = offset
            currentOrigin = result.Position + (offset.Unit * 0.05)
        else
            return false
        end
    end
    return false
end

local function isValidEnemy(player)
    if not player or player == LocalPlayer or not player.Character then return false end
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
    local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart or humanoid.Health <= 0 then return false end
    if player.Character:FindFirstChildOfClass("ForceField") then return false end
    if State.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then return false end
    return true
end

-- ==========================================
-- 3. TARGET SERVICE
-- ==========================================
local TargetService = {
    CurrentTarget = nil,
    TargetPart = nil
}

function TargetService:GetTargetPart(char)
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")

    if State.TargetPartMode == "Head" then
        return char:FindFirstChild("Head") or root
    elseif State.TargetPartMode == "Random" then
        local parts = {"Head", "UpperTorso", "LowerTorso", "HumanoidRootPart"}
        local available = {}
        for _, name in ipairs(parts) do
            local part = char:FindFirstChild(name)
            if part then table.insert(available, part) end
        end
        if #available > 0 then
            return available[math.random(1, #available)]
        end
    end

    return root
end

function TargetService:ReleaseTarget()
    self.CurrentTarget = nil
    self.TargetPart = nil
end

function TargetService:IsTargetStillValid()
    local player = self.CurrentTarget
    local part = self.TargetPart

    if not player or not player.Character or not part or not part.Parent then
        return false
    end

    if not part:IsDescendantOf(player.Character) then
        return false
    end

    return isValidEnemy(player)
end

function TargetService:Update()
    if not self:IsTargetStillValid() then
        self:ReleaseTarget()
        return false
    end
    return true
end

function TargetService:KeepTarget(camera, screenCenter)
    if not self:IsTargetStillValid() then 
        self:ReleaseTarget()
        return false 
    end

    if State.WallCheck and not VisibilityService:CheckVisibility(self.CurrentTarget.Character, 1) then 
        return false 
    end

    local screenPoint, onScreen = camera:WorldToViewportPoint(self.TargetPart.Position)
    if not onScreen then return false end

    local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - screenCenter).Magnitude
    if dist > (State.FOV * 1.2) then return false end

    return true
end

function TargetService:AcquireTarget(camera, screenCenter)
    local closestPlayer = nil
    local shortestDist = State.FOV
    local bestPart = nil

    for _, player in ipairs(Players:GetPlayers()) do
        if isValidEnemy(player) then
            local tempPart = self:GetTargetPart(player.Character)
            if tempPart and (not State.WallCheck or VisibilityService:CheckVisibility(player.Character, 1)) then
                local screenPoint, onScreen = camera:WorldToViewportPoint(tempPart.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - screenCenter).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestPlayer = player
                        bestPart = tempPart
                    end
                end
            end
        end
    end

    if closestPlayer then
        self.CurrentTarget = closestPlayer
        self.TargetPart = bestPart
    end
end
